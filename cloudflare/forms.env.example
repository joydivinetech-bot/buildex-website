# Copy these values into Cloudflare Pages production variables/bindings.
# Never commit real secret values.
PUBLIC_ORIGIN=https://buildexconstructions.com
NOTIFICATION_TO=YOUR_NOTIFICATION_EMAIL
# Verify this sending domain with your email provider before using this address.
NOTIFICATION_FROM=inquiries@buildexconstructions.com
TURNSTILE_SITE_KEY=
# Store both following values as encrypted secrets in Cloudflare, not in public JS.
TURNSTILE_SECRET_KEY=
CLOUDFLARE_EMAIL_API_TOKEN=
# Account ID is not a secret. Restrict the token to Email Sending: Edit for this account.
CLOUDFLARE_ACCOUNT_ID=
# Add a D1 database binding named DB and apply cloudflare/schema.sql,
# then cloudflare/inquiry-notifications.sql.
# After setup: Pages build command npm run build:forms; output public-launch.
