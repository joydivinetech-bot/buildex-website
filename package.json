{
  "name": "buildex-standalone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Independent Buildex HTML/CSS/JavaScript website and Node.js backend",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/admin-user.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "build:public": "node scripts/export-launch.mjs"
  }
}
